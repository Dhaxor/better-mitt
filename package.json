{
  "name": "better-mitt",
  "version": "1.0.1",
  "description": "Enhanced tiny (~400b) functional event emitter / pubsub with TypeScript support",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.min.js",
  "jsdelivr": "dist/index.min.js",
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "build:min": "terser dist/index.js -c -m -o dist/index.min.js",
    "build:umd": "node scripts/build-umd.js",
    "build:all": "npm run build && npm run build:min && npm run build:umd",
    "prepublishOnly": "npm run build:all",
    "example:js": "node example.js",
    "example:ts": "ts-node example.ts",
    "prepare-release": "node scripts/prepare-release.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhaxor/better-mitt.git"
  },
  "keywords": [
    "events",
    "event-emitter",
    "eventemitter",
    "emitter",
    "pubsub",
    "pub-sub",
    "event-bus",
    "observer",
    "mitt",
    "typescript",
    "lightweight",
    "tiny"
  ],
  "author": "Gain John",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dhaxor/better-mitt/issues"
  },
  "homepage": "https://github.com/dhaxor/better-mitt#readme",
  "files": [
    "dist",
    "src",
    "example.js",
    "example.ts",
    "README.md",
    "LICENSE",
    "IMPROVEMENTS.md"
  ],
  "engines": {
    "node": ">=12.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "terser": "^5.39.2",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  }
}
